# Nome da conta de storage
AZURE_STORAGE_ACCOUNT=rentmasterstorageaccount

# Chave de acesso (Primary Key)
AZURE_STORAGE_KEY=Jw9bPyGV5SZ1tupWyvMFR1SYvIv5+YIcs19L38vJTYTA0v1MfOJaETAbmfHTaVD4QlpuUKGgtAdD+AStk+M8zg==

# Nome do container no ADLS Gen2
ADLS_CONTAINER=bronze

# Caminho dentro do container onde estão os JSON
