
# ===== SHARED AZURE CONFIGURATION =====
# Tenant ID (compartilhado entre módulos)
AZURE_TENANT_ID=dfb66dc4-3f3c-492c-991d-727dbd1c89d4

# ===== SHARED STORAGE =====
# Storage Account (compartilhado entre módulos)
STORAGE_ACCOUNT_NAME=rentmasterstorageaccount

# ===== NOTES =====
# - Cada módulo (scrapper, workflows/*) tem seu próprio .env com credenciais específicas
# - As variáveis aqui são herdadas automaticamente pelos módulos
# - Para usar com docker-compose: --env-file .env --env-file ./modulo/.env