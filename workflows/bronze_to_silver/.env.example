# ===== SERVICE PRINCIPAL ESPECÍFICO =====
# Service Principal: rentmaster-bronze-pipeline (compartilhado com populate_database)
AZURE_CLIENT_ID="80eefc6e-1dee-4f07-9e43-540c0130f205"
AZURE_CLIENT_SECRET="your-secret-here"
# Note: AZURE_TENANT_ID é herdado do .env raiz

# ===== STORAGE =====
CONTAINER_NAME=bronze
BLOB_PREFIX=raw/
OUTPUT_CONTAINER=silver
# Note: STORAGE_ACCOUNT_NAME é herdado do .env raiz

# ===== INPUT MODE (escolha um) =====
# MODO 1: Processa arquivo ESPECÍFICO (para Data Factory pipeline)
# INPUT_FILE="imoveis_20260607_141126.json"

# MODO 2: Processa TODOS os arquivos (legado, padrão se INPUT_FILE vazio)
# LOCAL_JSON_DIR=./sample_data  (desenvolvimento local)
# OU
# USE_AZURE=true  (produção - lê todos de bronze/raw/)

# ===== PROCESSING =====
LOG_LEVEL=INFO
PIPELINE_VERSION=1.0

# ===== OUTPUT PATHS (local) =====
OUTPUT_PATH=./silver/cleaned
REJECTED_PATH=./silver/rejected

# ===== USAGE EXAMPLES =====
# MODO 1 - Arquivo específico (Azure):
#   docker run \
#     -e INPUT_FILE="imoveis_20260607_141126.json" \
#     -e USE_AZURE=true \
#     --env-file .env \
#     --env-file ../../.env \
#     bronze-to-silver:latest

# MODO 1 - Arquivo específico (Local):
#   INPUT_FILE="imoveis_sample.json" \
#   LOCAL_JSON_DIR=./sample_data \
#   OUTPUT_PATH=./silver/cleaned \
#   python main.py

# MODO 2 - Todos os arquivos (Azure):
#   docker run \
#     -e USE_AZURE=true \
#     --env-file .env \
#     --env-file ../../.env \
#     bronze-to-silver:latest

# MODO 2 - Todos os arquivos (Local):
#   LOCAL_JSON_DIR=./sample_data python main.py

