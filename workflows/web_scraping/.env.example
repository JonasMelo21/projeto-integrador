# ===== SERVICE PRINCIPAL ESPECÍFICO =====
# Service Principal: rentmaster-scraper
AZURE_CLIENT_ID="3f678962-1db7-410e-b4c8-ff71749a6715"
AZURE_CLIENT_SECRET="your-secret-here"
# Note: AZURE_TENANT_ID é herdado do .env raiz

# ===== SCRAPER CONFIGURATION =====
NUM_PAGES=2
FORMAT=json
TIMEOUT_MS=45000

# ===== STORAGE =====
CONTAINER_NAME=scraper
# Note: STORAGE_ACCOUNT_NAME é herdado do .env raiz

# ===== USAGE =====
# docker-compose --profile scraper up --build scraper --env-file .env --env-file ../.env
