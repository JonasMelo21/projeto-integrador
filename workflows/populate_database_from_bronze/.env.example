# ===== SERVICE PRINCIPAL ESPECÍFICO =====
# Service Principal: rentmaster-bronze-pipeline
AZURE_CLIENT_ID="80eefc6e-1dee-4f07-9e43-540c0130f205"
AZURE_CLIENT_SECRET="your-secret-here"
# Note: AZURE_TENANT_ID é herdado do .env raiz

# ===== STORAGE =====
CONTAINER_NAME=bronze
BLOB_PREFIX=raw/
# Note: STORAGE_ACCOUNT_NAME é herdado do .env raiz

# ===== DATABASE =====
DB_PATH=/data/rental.db
DB_CONNECTION_STRING=sqlite:///./rental.db

# ===== EMAIL (Gmail SMTP) =====
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=""
EMAIL_TO=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== USAGE =====
# docker-compose up --env-file .env --env-file ../../.env